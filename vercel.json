{
  "regions": ["bom1"],
  "functions": { "api/*.js": { "maxDuration": 60 } },
  "headers": [
    { "source": "/(.*\\.(?:png|jpg|svg|ico|woff2))", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(app\\.js|appconfig\\.js|sw\\.js|index\\.html)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
